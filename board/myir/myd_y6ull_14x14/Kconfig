if TARGET_MYD_MX6ULL_14X14

config MYD_DDR_CAPACITY_MB
	int "MYD board physical DDR size (MiB, for reporting and kernel DT fixup)"
	default 256
	range 0 1024
	help
	  dram_init() uses get_ram_size() up to 512 MiB so gd->ram_size matches
	  populated DRAM even when imx_ddr_size() follows an oversized DCD.

	  If non-zero, gd->ram_size is then clamped to this many MiB (useful for
	  per-SKU defconfigs or if probing must be capped). Use 0 for no clamp.

	  Typical values: 256 (DDR256 NAND defconfig), 512 (DDR512 NAND or eMMC).
	  The DCD file (CONFIG_IMX_CONFIG / imximage*.cfg) must match hardware; the
	  ddr512 and emmc defconfigs set imximage-ddr512.cfg for 512 MiB MMDC.

config SYS_BOARD
	default "myd_y6ull_14x14"

config SYS_VENDOR
	default "myir"

config SYS_CONFIG_NAME
	default "myd_y6ull_14x14"
	
config IMX_CONFIG
	default "board/myir/myd_y6ull_14x14/imximage.cfg"
	
config TEXT_BASE
	default 0x87800000
endif
