if TARGET_MYD_MX6ULL_14X14

config MYD_DDR_CAPACITY_MB
	int "MYD board physical DDR size (MiB, for reporting and kernel DT fixup)"
	default 256
	range 0 1024
	help
	  imx_ddr_size() reads MMDC geometry and can over-report versus actual
	  populated DRAM. U-Boot clamps gd->ram_size to this value so
	  arch_fixup_fdt() passes the correct /memory reg to Linux.

	  Use 0 to disable clamping (gd->ram_size = imx_ddr_size() only). This
	  can serve a single NAND image on 256 MiB and 512 MiB boards when MMDC
	  reports the true size; if any SKU over-reports, build per-SKU defconfig
	  with 256 / 512 instead.

	  Typical values: 256 (DDR256 NAND / default), 512 (DDR512 NAND or eMMC).

config SYS_BOARD
	default "myd_y6ull_14x14"

config SYS_VENDOR
	default "myir"

config SYS_CONFIG_NAME
	default "myd_y6ull_14x14"
	
config IMX_CONFIG
	default "board/myir/myd_y6ull_14x14/imximage.cfg"
	
config TEXT_BASE
	default 0x87800000
endif
